#!/bin/bash
#
# /lib/systemd/system-sleep/performance-plus
#
# Systemd sleep hook that re-applies Performance Plus (Ultra) ryzenadj
# settings after resume from suspend/hibernate.
#
# Called by systemd with: $1 = pre|post, $2 = suspend|hibernate|hybrid-sleep|suspend-then-hibernate
#
# Only runs ryzenadj on POST (resume), never on pre-suspend.
# The throttle in ~/.local/bin/ryzenadj prevents rapid re-application.
#

STATE_FILE="/var/lib/performance-plus/active"

case "$1" in
    post)
        # Small delay to let the system fully wake before hitting the hardware
        sleep 2
        # Re-apply Ultra ryzenadj settings if Ultra mode is active
        if [[ -f "$STATE_FILE" ]]; then
            /home/naomarik/.local/bin/ryzenadj \
                --fast-limit=120000 \
                --slow-limit=85000 \
                --apu-slow-limit=85000 \
                --set-coall=0x0FFFF1
        # Re-apply the per-profile undervolt for the non-Ultra profiles. The CO
        # offset does not survive suspend, so it must be reasserted on resume.
        else
            case "$(powerprofilesctl get 2>/dev/null)" in
                # performance boosts clocks/voltage, so it needs a milder undervolt
                performance)          /home/naomarik/.local/bin/ryzenadj --set-coall=0x0fffdd ;;  # -35
                balanced|power-saver) /home/naomarik/.local/bin/ryzenadj --set-coall=0x0fffd8 ;;  # -40
            esac
        fi
        ;;
    pre)
        # Nothing to do before suspend
        ;;
esac
